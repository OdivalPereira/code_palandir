# ==============================================================================
# Code Palandir - Environment Configuration
# ==============================================================================

# [Local Development Only]
PORT=3000
APP_BASE_URL=http://localhost:5174
SERVER_BASE_URL=http://localhost:3000

# [Google Gemini AI - Required for AI Analysis & Optimization]
GOOGLE_AI_API_KEY=your_google_ai_api_key
GOOGLE_AI_MODEL_ID=gemini-2.5-flash
AI_PROVIDER=google

# [GitHub OAuth - Optional if using Client-Side PAT in the UI]
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# In Vercel, this defaults automatically to: https://<your-vercel-domain>/api/auth/callback
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback

# [Vercel Deployment Notes]
# When deploying to Vercel:
# 1. Add GOOGLE_AI_API_KEY in Project Settings > Environment Variables.
# 2. Add GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET if you want server OAuth (or leave blank to use in-browser PAT).

